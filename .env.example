# ============================================================
# Variables de l'application (Vercel → Settings → Environment Variables)
#
# Tout ce qui est ici part dans le navigateur : ne jamais y mettre un
# secret. Les jetons des plateformes vivent dans Supabase (Vault et
# secrets de fonctions), pas ici.
# ============================================================

VITE_SUPABASE_URL=https://cnyjtqbjzzgblmxqcbzw.supabase.co
VITE_SUPABASE_ANON_KEY=

# L'interrupteur. Absent ou `false` : les écrans affichent le jeu de
# démonstration et aucun appel ne part vers les plateformes. `true` :
# tout lit la base et les connecteurs appellent vraiment les API.
VITE_DONNEES_REELLES=false
